# Cliente(s) -> Gateway: UNA sola API key
API_KEY=change-this-to-a-strong-random-key

# Publicación (loopback por defecto; expone solo vía reverse proxy HTTPS)
HOST=127.0.0.1
PORT=8000
REQUEST_TIMEOUT=120
# Evita truncar razonamiento/tool_calls cuando el cliente omite max_tokens.
CHAT_DEFAULT_MAX_TOKENS=4000

# Spacing free-tier (Pollinations anónimo ~1 respuesta/45s/IP)
POLLINATIONS_MIN_INTERVAL=46
FREE_TIER_MAX_WAIT=60

# Anti-bloqueo / anti-ciclos del fallback
# Presupuesto total por request: nunca se espera/sleep más allá de esto.
REQUEST_BUDGET=45
STREAM_START_BUDGET=12
# Circuit breaker por proveedor: tras errores de cuenta/cuota se saltan TODOS sus modelos.
PROVIDER_BREAKER_THRESHOLD=3
PROVIDER_BREAKER_COOLDOWN=60

# Fallback local Qwen vía Ollama (recomendado; requiere ollama.service en 127.0.0.1:11434)
# LOCAL_OLLAMA_ENABLED=1
# LOCAL_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
# Modelo observado con tools y buen código local (30.5B Q4_K_M; 8 GB VRAM):
# LOCAL_OLLAMA_MODEL=qwen3-coder-opt:latest
# Mínimo de tokens para que el modo thinking termine y deje contenido:
# LOCAL_OLLAMA_MIN_TOKENS=512
# Desactivar thinking (recomendado; el endpoint nativo de Ollama sí lo respeta):
# LOCAL_OLLAMA_THINK=0
# Contexto local (KimiCode necesita al menos 16384):
# LOCAL_OLLAMA_CTX=16384

# Backend local opcional llama-cpp-python (OpenAI-compatible; opt-in, no autoarranca)
# Más lento que Ollama para Qwen3-Coder 30B en 8 GB VRAM; útil para modelos que
# caben completos en GPU o para comparación. Arranque manual: ./deploy/llamacpp-server.sh
# LOCAL_LLAMACPP_ENABLED=0
# LOCAL_LLAMACPP_BASE_URL=http://127.0.0.1:11438/v1
# LOCAL_LLAMACPP_MODEL=qwen3-coder-opt
# LOCAL_LLAMACPP_TIMEOUT=600

# Fallback local NCM experimental (opt-in; requiere ncm-instruct.service en 127.0.0.1:11435)
# Límites honestos: 725M, contexto 128, inglés/minúsculas, CC BY-NC-SA 4.0 (no comercial).
# No ejecutar NCM y Ollama 9B a la vez en 8 GB de VRAM.
# NCM_LOCAL_ENABLED=0
# NCM_LOCAL_BASE_URL=http://127.0.0.1:11435/v1
# NCM_LOCAL_MODEL=ncm-instruct-725m

# NCM oficial LM1B-large (725M, unconditional; solo modelo explícito, NO en auto)
# Requiere ncm-lm1b.service en 127.0.0.1:11436.
# NCM_LM1B_ENABLED=0
# NCM_LM1B_BASE_URL=http://127.0.0.1:11436/v1
# NCM_LM1B_MODEL=ncm-lm1b-large

# Puente jmbigi/thinker (DeepResearchThinkingLayer + VeracityLayer)
# Requiere thinker.service en 127.0.0.1:11437 y el clon en THINKER_HOME.
# THINKER_ENABLED=1
# THINKER_BASE_URL=http://127.0.0.1:11437
# THINKER_TIMEOUT=300

# Control de gratuidad (importante)
# FREE_ONLY=1: solo permite candidatos free-tier explícitos/anónimos (:free, Pollinations).
# No garantiza gratuidad ilimitada upstream: cuotas/rate limits/créditos dependen del proveedor/cuenta.
FREE_ONLY=1
ALLOW_PAID_MODELS=0
VERIFY_FREE_TIER=1
BLOCK_UNKNOWN_PAID=1

# Caché (prompts/respuestas cacheables)
CACHE_ENABLED=1
CACHE_TTL_SECONDS=300
CACHE_MAX_ENTRIES=1000
CACHE_MAX_PROMPT_CHARS=24000

# Compresión de contextos
CONTEXT_COMPRESS_ENABLED=1
CONTEXT_MAX_CHARS=120000
CONTEXT_KEEP_LAST_MESSAGES=12
CONTEXT_MESSAGE_MAX_CHARS=12000

# Herramientas locales (apagadas por defecto; no exponen ejecución por HTTP)
# GATEWAY_TOOLS_ROOT=/tmp
# GATEWAY_ALLOW_LOCAL_EXEC=0

# Opcional: agrega cuentas/proveedores gratuitos o configurables
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# NVIDIA_API_KEY=
# GEMINI_API_KEY=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# MISTRAL_API_KEY=
# SAMBANOVA_API_KEY=
# CEREBRAS_API_KEY=
# HUGGINGFACE_API_KEY=
# TOGETHER_API_KEY=
# COHERE_API_KEY=
# DEEPSEEK_API_KEY=
# MOONSHOT_API_KEY=   # Kimi/Moonshot
# OPENCODE_API_KEY=
# OPENCODE_BASE_URL=https://opencode.ai/zen/v1
# CUSTOM_OPENAI_API_KEY=
# CUSTOM_OPENAI_BASE_URL=https://provider.example/v1
# CUSTOM_OPENAI_MODELS=model-a,model-b

# Nombre recomendado para clientes (el servidor acepta también API_KEY)
# FT_AI_API_KEY=change-this-to-a-strong-random-key

# Optional: LLM7 (key optional; availability/rate limits vary)
LLM7_BASE_URL=https://api.llm7.io/v1
LLM7_API_KEY=

# Public base URL shown in help/docs/health (optional)
PUBLIC_BASE_URL=https://ia.forthtrade.com
