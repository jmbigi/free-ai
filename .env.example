# Client access key for THIS gateway (required)
API_KEY=change-me

# Optional upstream provider keys (enable more free models automatically when set)
GROQ_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
HUGGINGFACE_API_KEY=
TOGETHER_API_KEY=
SAMBANOVA_API_KEY=
COHERE_API_KEY=
CEREBRAS_API_KEY=

# Performance: prompt/response cache + context compression
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300
CACHE_MAX_ITEMS=512
CONTEXT_COMPRESS_ENABLED=true
CONTEXT_MAX_CHARS=120000
CONTEXT_KEEP_LAST_MESSAGES=12
CONTEXT_MESSAGE_MAX_CHARS=12000
CONTEXT_SUMMARY_MAX_CHARS=4000
